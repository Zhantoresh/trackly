# Copy this to .env (same directory as docker-compose.yml) and fill in real
# values before running `docker compose up -d`. .env is gitignored — never
# commit real secrets.

DB_PASSWORD=change-me
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# First admin account, created automatically on first backend boot.
ADMIN_EMAIL=admin@trackly.dev
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# Public path DevOps routes this project under. Change these three (and
# only these three) if the project ever moves to a different path.
PUBLIC_BASE_URL=https://esg.kbtu.kz/trackly
VITE_BASE_PATH=/trackly/
VITE_API_URL=/trackly
