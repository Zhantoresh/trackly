# On Railway, set this to the reference variable ${{Postgres.DATABASE_URL}}
# (Postgres plugin living in the same Railway project as this service).
# For local dev, point it at your local/staging Postgres instance.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/trackly

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File storage: uploaded task files are written to disk and served by this API.
# On Railway, mount a Volume at this path so files survive redeploys.
UPLOAD_DIR=/app/uploads
# The public URL this backend is reachable at (Railway -> Settings -> Networking -> Domain).
# Used to build links like <PUBLIC_BASE_URL>/files/<project>/<task>/<file>.
PUBLIC_BASE_URL=https://trackly-backend.up.railway.app

# Первый admin создаётся автоматически при старте контейнера (app/scripts/create_admin.py).
# Обязательны при первом деплое; если admin уже создан, скрипт их игнорирует и просто выходит.
ADMIN_EMAIL=admin@trackly.dev
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin