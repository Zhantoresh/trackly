# On Railway, set this to the reference variable ${{Postgres.DATABASE_URL}}
# (Postgres plugin living in the same Railway project as this service).
# For local dev, point it at your local/staging Postgres instance.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/trackly

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage stays on Supabase (Storage only — DB no longer lives here)
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key